# macOS
.DS_Store

# fish
fish/.config/fish/completions/
fish/.config/fish/conf.d/
fish/.config/fish/fish_variables

# tmux — TPM plugins (installed locally)
tmux/.config/tmux/plugins/

# yazi — installed by `ya pkg install`
yazi/.config/yazi/plugins/
yazi/.config/yazi/flavors/

# karabiner — local backups/assets from Elements UI
karabiner/.config/karabiner/automatic_backups/
karabiner/.config/karabiner/assets/

# opencode — npm install in ~/.config/opencode
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package-lock.json

# dooit — local todo database + python cache
dooit/Library/Application Support/dooit/dooit.db
dooit/**/__pycache__/
dooit/**/*.pyc

# nvim — local logs and vim.pack lockfiles (plugins live in stdpath data)
nvim.log
nvim/nvim-pack-lock.json
nvim/.config/nvim/nvim-pack-lock.json